# Copy to `.env.local` for local development (and set these on the server as
# apps/web/.env.production).

# PostgreSQL connection (self-hosted). Local dev via `pnpm db:up`:
DATABASE_URL=postgresql://airhouse:airhouse_dev@localhost:5432/airhouse

# Admin seed — used by `pnpm seed:admin` (scripts/seed-admin.ts).
ADMIN_EMAIL=admin@yourcompany.mn
ADMIN_PASSWORD=change-me
