# Copy this file to `.env.local` (same folder) and fill from Supabase.
# Project Settings -> API in your Supabase dashboard.

# Public — used by the login/auth flow (safe in the browser).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-only — used by @airlink/core for all data writes. NEVER expose.
SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# The admin login email. This account gets full access; every other login is a
# read-only worker who sees only their own profile.
ADMIN_EMAIL="you@your-company.com"
