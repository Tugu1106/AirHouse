{
  "name": "@airlink/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "airhouse-mcp": "dist/airhouse-mcp.cjs"
  },
  "scripts": {
    "build": "esbuild src/stdio.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/airhouse-mcp.cjs --external:pg-native --external:cloudflare:sockets",
    "start": "node dist/airhouse-mcp.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@airlink/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
