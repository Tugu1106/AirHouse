{
  "name": "airlink-asset-tracker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @airlink/web dev",
    "build": "pnpm --filter @airlink/web build",
    "start": "pnpm --filter @airlink/web start",
    "lint": "pnpm --filter @airlink/web lint",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "smoke": "tsx scripts/smoke-core.ts && tsx scripts/smoke-auth.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.5",
    "typescript": "^5.7.2"
  }
}
