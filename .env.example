# ---------------------------------------------------------------------------
# Airlink Asset Tracker — environment variables
# Copy this file to `apps/web/.env.local` and fill in the values from your
# Supabase project (Project Settings -> API).
# ---------------------------------------------------------------------------

# Public (safe to expose to the browser) — used by the auth/login flow.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-only (NEVER expose to the browser) — used by packages/core for all
# data writes. This is the service_role key; it bypasses RLS. Keep it secret.
SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
