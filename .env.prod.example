# Server production config — copy to ~/airhouse/.env on the server (gitignored).
# docker compose reads this automatically for docker-compose.prod.yml.

# Postgres credentials (used by both the db container and the web DATABASE_URL).
POSTGRES_USER=airhouse
POSTGRES_PASSWORD=CHANGE-ME-to-a-strong-password
POSTGRES_DB=airhouse

# Admin login — auto-seeded on web startup if it doesn't already exist.
ADMIN_EMAIL=you@company.mn
ADMIN_PASSWORD=CHANGE-ME-admin-password
